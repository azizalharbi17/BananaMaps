# ---- Supabase (project shared with the worker) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server routes, worker, public API metering

# ---- Data providers ----
MORALIS_API_KEY=
HELIUS_API_KEY=
VYBE_API_KEY=
SOLSCAN_API_KEY=                      # optional
CRON_SECRET=                          # Vercel cron auth

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=                    # sk_test_… while testing, sk_live_… at launch
STRIPE_WEBHOOK_SECRET=                # printed by scripts/stripe-setup.mjs (or Stripe → Developers → Webhooks)
NEXT_PUBLIC_SITE_URL=https://www.bananamaps.io   # Checkout/portal return URLs

# ---- Abuse controls ----
# SIGNUPS_PER_IP_PER_DAY=3            # developer accounts one IP may create per day

# ---- Robinhood Chain RPC (optional; defaults to the public RPC) ----
# ROBINHOOD_RPC_URLS=http://10.0.0.2:8547,https://rpc.mainnet.chain.robinhood.com
