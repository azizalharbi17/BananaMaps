# ---- Supabase (same project as the Next.js app) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # required: the worker writes token_graphs / indexed_tokens / token_sync_state

# ---- Providers ----
MORALIS_API_KEY=
HELIUS_API_KEY=
VYBE_API_KEY=                         # Solana top holders (free key works)
SOLSCAN_API_KEY=                      # optional labels (paid plan)

# ---- Store ----
STORE=supabase                        # supabase | file   (file = local JSON under worker/.data, for dev/testing)
# GRAPH_SINK=supabase                 # where finished graphs go; defaults to STORE. STORE=file + GRAPH_SINK=supabase = test registry locally, publish real graphs
# DATA_DIR=./.data

# ---- Scheduling ----
LOOP_TICK_MS=15000
MAX_CONCURRENT_SYNCS=3
CONCURRENCY_EVM=2
CONCURRENCY_SOL=1                     # Helius free plan is 10 req/s; one SOL sync at a time keeps batches under it
# HELIUS_BATCH=5                      # JSON-RPC requests per HTTP call (each counts toward the rate limit)
# HELIUS_BATCH_PAUSE_MS=600
CONCURRENCY_ROBINHOOD=1
INTERVAL_HOT_MS=600000                # 10 min
INTERVAL_WARM_MS=3600000              # 1 h
INTERVAL_COLD_MS=86400000             # 24 h
# INTERVAL_MULT_SOL=1                 # per-chain multiplier on the tier interval (SOL polls one call per active holder)
HOLDERS_REFRESH_HOT_MS=3600000        # authoritative top-150 re-fetch cadence per tier
HOLDERS_REFRESH_WARM_MS=21600000
HOLDERS_REFRESH_COLD_MS=86400000
FULL_REBUILD_EVERY_MS=2592000000      # 30 d — scheduled drift reset (full builds only run with ≥30% of the day's provider cap left)
MAX_FULL_BUILDS_PER_HOUR=6
TRENDING_EVERY_MS=21600000            # 6 h — GeckoTerminal enrollment
TRENDING_PER_CHAIN=4

# ---- Tiering (liquidity + 24h volume, USD) ----
TIER_HOT_VOLUME_USD=1000000
TIER_HOT_LIQ_USD=500000
TIER_WARM_VOLUME_USD=50000
TIER_WARM_LIQ_USD=50000

# ---- Hard daily provider caps (requests/day, UTC) ----
BUDGET_MORALIS_PER_DAY=800            # ~50 CU each → ~40k CU/day of the 66k/day a 2M CU/month plan allows
BUDGET_HELIUS_PER_DAY=20000           # counts every JSON-RPC request (batch elements included), like Helius does
BUDGET_VYBE_PER_DAY=1500
BUDGET_BLOCKSCOUT_PER_DAY=2000
BUDGET_ROBINHOOD_RPC_PER_DAY=20000
BUDGET_PUBLICNODE_PER_DAY=2000
BUDGET_DEXSCREENER_PER_DAY=5000
BUDGET_GECKOTERMINAL_PER_DAY=200

# ---- Resilience ----
BACKOFF_BASE_MS=600000                # per-token: 10 min × 2^errors, capped
BACKOFF_MAX_MS=86400000
CIRCUIT_ERRORS=5                      # provider errors inside 5 min → provider paused
CIRCUIT_OPEN_MS=300000
STALL_ALERT_MS=1800000                # 30 min without a completed loop → worker_alerts row

# ---- Sync tuning ----
MAX_DELTA_PAGES=10                    # token-wide delta pages per sync (EVM/Blockscout); overflow = advance cursor, log truncated
MAX_CP_PER_HOLDER=300                 # distinct counterparties kept per holder
SOL_MAX_SIG_PAGES=3                   # signature pages (100 each) per holder account per sync
SOL_IDLE_BACKOFF_MAX=12               # idle holder accounts are polled every 2^n syncs up to this many
RH_HISTORY_BLOCKS=2000000             # Robinhood: eth_getLogs window for a new holder's history when Blockscout is down
SKIP_LABELED_HISTORY=1                # don't poll histories of cex/dex/contract/burn holders (their edges come from the other side)

# ---- Ops ----
HEALTH_PORT=8787
LOG_FORMAT=json                       # json | pretty
# WORKER_ID=vps-1
